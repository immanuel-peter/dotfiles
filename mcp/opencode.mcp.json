{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Hugging Face": {
      "type": "remote",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:HF_TOKEN}"
      },
      "enabled": true
    },
    "Shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "Chrome DevTools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "GitHub": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
      },
      "enabled": true
    },
    "Perplexity": {
      "type": "local",
      "command": ["npx", "-y", "@perplexity-ai/mcp-server"],
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}",
        "PERPLEXITY_TIMEOUT_MS": "600000"
      },
      "enabled": true
    },
    "DeepWiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "Markitdown": {
      "type": "local",
      "command": ["uvx", "markitdown-mcp"],
      "enabled": true
    },
    "OpenAI Docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true
    },
    "Claude Code Docs": {
      "type": "remote",
      "url": "https://code.claude.com/docs/mcp",
      "enabled": true
    },
    "xAI Docs": {
      "type": "remote",
      "url": "https://docs.x.ai/api/mcp",
      "enabled": true
    },
    "alphaXiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1",
      "headers": {
        "Authorization": "Bearer {env:ALPHAXIV_API_KEY}"
      },
      "enabled": true
    },
    "Remotion Documentation": {
      "type": "local",
      "command": ["npx", "@remotion/mcp@latest"],
      "enabled": true
    },
    "Playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
