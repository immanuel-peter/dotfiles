{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Hugging Face": {
      "type": "remote",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:HF_TOKEN}"
      },
      "enabled": true
    },
    "Shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "Chrome DevTools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "GitHub": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
      },
      "enabled": true
    },
    "Perplexity": {
      "type": "remote",
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:PERPLEXITY_API_KEY}"
      },
      "enabled": true
    },
    "DeepWiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "Markitdown": {
      "type": "local",
      "command": ["uvx", "markitdown-mcp"],
      "enabled": true
    },
    "OpenAI Docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true
    },
    "Claude Code Docs": {
      "type": "remote",
      "url": "https://code.claude.com/docs/mcp",
      "enabled": true
    },
    "Brev Docs": {
      "type": "remote",
      "url": "https://docs.nvidia.com/brev/_mcp/server",
      "enabled": true
    },
    "xAI Docs": {
      "type": "remote",
      "url": "https://docs.x.ai/api/mcp",
      "enabled": true
    },
    "alphaXiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1",
      "headers": {
        "Authorization": "Bearer {env:ALPHAXIV_API_KEY}"
      },
      "enabled": true
    },
    "Remotion Documentation": {
      "type": "local",
      "command": ["npx", "@remotion/mcp@latest"],
      "enabled": true
    },
    "Playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "Agent Browser": {
      "type": "local",
      "command": ["agent-browser", "mcp"],
      "enabled": true
    },
    "xurl": {
      "type": "local",
      "command": ["xurl", "mcp", "https://api.x.com/mcp"],
      "timeout": 300000,
      "enabled": true
    },
    "OpenRouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    }
  }
}
